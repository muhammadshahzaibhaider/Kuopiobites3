# Backend-only secrets. NEVER duplicate these in the frontend.
PORT=4000
# Random 256-bit secret for signing JWTs
JWT_SECRET=change-me-in-production
# Comma-separated allowlist of frontend origins (no wildcard in real deployments)
CORS_ORIGINS=http://localhost:3000
# SQLite database file
DB_FILE=./data/kuopio.db
# Hosted checkout (Stripe-style) keys — used only by the backend payment module
STRIPE_SECRET_KEY=
# Product-photography pipeline key (backend job, never exposed to clients)
IMAGEGEN_API_KEY=
