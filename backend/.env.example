# Backend-only configuration. Never copy these names into frontend/.env*.
# Production values belong in the deployment secret manager, not this file.
NODE_ENV=development
PORT=4000

# Exact browser origins, comma-separated. No wildcard and no trailing slash.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Supabase API access. The secret key is server-only and never belongs in frontend/.env*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Needed only for schema migrations/dumps via the Supabase CLI. Keep its database password private.
SUPABASE_DB_URL=

# HttpOnly cookie session settings. The browser never receives the signing secret.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Abuse controls (all are server-side; tune again at the edge/WAF in production).
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
ORDER_RATE_WINDOW_MS=900000
ORDER_RATE_MAX=30
RESERVATION_RATE_WINDOW_MS=900000
RESERVATION_RATE_MAX=20
UPLOAD_RATE_WINDOW_MS=900000
UPLOAD_RATE_MAX=30
NEWSLETTER_RATE_WINDOW_MS=3600000
NEWSLETTER_RATE_MAX=5
JSON_BODY_LIMIT=2mb

# Optional provider integrations. Leave blank until configured by the operator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kuopio Bites <no-reply@kuopiobites.fi>
IMAGEGEN_API_KEY=

# Legacy SQLite export tooling only; normal API uploads use the Supabase Storage bucket.
DB_FILE=./data/kuopio.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# Only for a local demo without a payment provider. Production rejects this value.
ALLOW_DEMO_PAYMENTS=false
