# Contact lead destination — configure ONE to enable real delivery
# If none are set, /api/contact runs in honest preview mode: validates + logs, but does not forward.
CONTACT_WEBHOOK_URL=https://example.com/webhook/axiom-leads
# OR email via Resend:
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=leads@axiomlabs.agency
# CONTACT_FROM_EMAIL=Axiom Labs <noreply@axiomlabs.agency>
